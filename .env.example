APP_NAME="Billing App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=11

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: pick ONE -------------------------------------------------------
# SQLite (default, no server needed; file is database/database.sqlite)
DB_CONNECTION=sqlite

# MySQL 8 (create the database first: CREATE DATABASE billing_laravel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=billing_laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (create the database first: CREATE DATABASE billing_laravel;)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=billing_laravel
# DB_USERNAME=postgres
# DB_PASSWORD=

# Backups. SQLite is copied as a file; MySQL uses mysqldump; PostgreSQL uses pg_dump.
# On Windows give the full path of the tool you need, e.g.
# MYSQL_DUMP_PATH="D:\laragon\bin\mysql\mysql-8.0.33-winx64\bin\mysqldump.exe"
# PG_DUMP_PATH="C:\Program Files\PostgreSQL\16\bin\pg_dump.exe"
MYSQL_DUMP_PATH=mysqldump
PG_DUMP_PATH=pg_dump
BACKUP_KEEP=14

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
